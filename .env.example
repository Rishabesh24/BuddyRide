# RouteShare Environment Configuration
# Copy this file to .env.local for local overrides.
# The application automatically runs in rich fixture mode if external Supabase credentials are not provided.

# Supabase Persistence (Optional for local evaluation; required for remote PostgreSQL sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# App URL & Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Optional Routing & Geocoding Provider
# Default: Built-in deterministic geometric engine & OpenStreetMap tiles
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
